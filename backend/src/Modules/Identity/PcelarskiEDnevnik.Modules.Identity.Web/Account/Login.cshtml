@model PcelarskiEDnevnik.Modules.Identity.Web.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Sign in - Pčelarski eDnevnik</title>
</head>

<body>

    <main>
        <h1>Pčelarski eDnevnik</h1>

        <h2>Sign in</h2>

        <form method="post"
              asp-controller="Account"
              asp-action="Login">

            @Html.AntiForgeryToken()

            <input asp-for="ReturnUrl"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"></div>

            <div>
                <label asp-for="Email"></label>

                <input asp-for="Email"
                       autocomplete="email" />

                <span asp-validation-for="Email"></span>
            </div>

            <div>
                <label asp-for="Password"></label>

                <input asp-for="Password"
                       autocomplete="current-password" />

                <span asp-validation-for="Password"></span>
            </div>

            <div>
                <label>
                    <input asp-for="RememberMe" />
                    Remember me
                </label>
            </div>

            <button type="submit">
                Sign in
            </button>

        </form>
    </main>

</body>
</html>