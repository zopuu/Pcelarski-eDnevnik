@model PcelarskiEDnevnik.Modules.Identity.Web.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Prijava - Pčelarski eDnevnik</title>

    <style>
            :root {
                color-scheme: only light;

                --primary: #F59E0B;
                --primary-dark: #C96A05;

                --background: #FFF9EF;
                --surface: #FFFFFF;

                --foreground: #2A1D0B;
                --muted: #766755;

                --border: #EAD5AA;
                --error: #C2413B;
            }

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                min-height: 100%;
            }

            body {
                min-height: 100dvh;

                display: flex;
                align-items: center;
                justify-content: center;

                padding: 24px;

                background: var(--background);
                color: var(--foreground);

                font-family:
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    Roboto,
                    Arial,
                    sans-serif;
            }

            .login-container {
                width: 100%;
                max-width: 420px;
            }

            .brand {
                margin-bottom: 32px;
                text-align: center;
            }

            .brand h1 {
                margin: 0;

                font-size: 28px;
                font-weight: 800;
            }

            .brand p {
                margin: 8px 0 0;

                color: var(--muted);
                font-size: 14px;
            }

            .login-card {
                padding: 28px;

                border: 1px solid var(--border);
                border-radius: 24px;

                background: var(--surface);

                box-shadow:
                    0 10px 30px
                    rgba(42, 29, 11, 0.08);
            }

            .login-card h2 {
                margin: 0 0 24px;

                font-size: 22px;
            }

            .field {
                margin-bottom: 20px;
            }

            label {
                display: block;

                margin-bottom: 7px;

                font-size: 14px;
                font-weight: 600;
            }

            input[type="email"],
            input[type="password"] {
                width: 100%;
                min-height: 50px;

                padding: 12px 14px;

                border: 1px solid var(--border);
                border-radius: 14px;

                background: #FFFFFF;
                color: var(--foreground);

                font: inherit;
                font-size: 16px;

                outline: none;
            }

            input[type="email"]:focus,
            input[type="password"]:focus {
                border-color: var(--primary);

                box-shadow:
                    0 0 0 3px
                    rgba(245, 158, 11, 0.15);
            }

            .remember-me {
                display: flex;
                align-items: center;
                gap: 8px;

                margin-bottom: 24px;
            }

            .remember-me label {
                margin: 0;

                font-weight: 400;
            }

            .login-button {
                appearance: none;
                -webkit-appearance: none;

                width: 100%;
                min-height: 52px;

                border: none;
                border-radius: 14px;

                background: var(--primary);
                color: #2A1D0B;

                font: inherit;
                font-size: 16px;
                font-weight: 700;

                cursor: pointer;
            }

            .login-button:hover {
                background: var(--primary-dark);
                color: #FFFFFF;
            }

            .login-button:active {
                transform: scale(0.99);
            }

            .validation-summary,
            .field-validation-error {
                color: var(--error);
                font-size: 14px;
            }

            .validation-summary {
                margin-bottom: 18px;
            }

            .field-validation-error {
                display: block;
                margin-top: 6px;
            }
    </style>
</head>

<body>

    <main class="login-container">

        <div class="brand">
            <h1>Pčelarski eDnevnik</h1>

            <p>
                Prijavite se na svoj nalog
            </p>
        </div>

        <section class="login-card">

            <h2>Prijava</h2>

            <form method="post"
                  asp-controller="Account"
                  asp-action="Login">

                @Html.AntiForgeryToken()

                <input asp-for="ReturnUrl"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="field">

                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="field-validation-error">
                    </span>

                </div>

                <div class="field">

                    <label asp-for="Password">
                        Lozinka
                    </label>

                    <input asp-for="Password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="field-validation-error">
                    </span>

                </div>

                <div class="remember-me">

                    <input asp-for="RememberMe" />

                    <label asp-for="RememberMe">
                        Zapamti me
                    </label>

                </div>

                <button type="submit"
                        class="login-button">
                    Prijavi se
                </button>

            </form>

        </section>

    </main>

</body>
</html>