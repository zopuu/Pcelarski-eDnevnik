EXPO_PUBLIC_API_URL=https://localhost:YOUR_HTTPS_PORT

# Restrict this key to your web origin and enable Maps JavaScript API.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Restrict these keys to the Android package/SHA-1 and iOS bundle ID respectively.
# They are read only while creating a native build and are not available at runtime.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
